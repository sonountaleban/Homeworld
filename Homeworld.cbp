<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="HomeworldSDL" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/homeworld" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=gnu11" />
					<Add option="-g" />
					<Add option="-Wno-unused-result" />
					<Add option="`pkg-config --cflags sdl2`" />
					<Add option="-Wno-implicit-function-declaration" />
					<Add option="-Wno-incompatible-pointer-types" />
					<Add option="-Wno-int-conversion" />
					<Add option="-Wno-pointer-to-int-cast" />
					<Add option="-Wno-int-to-pointer-cast" />
					<Add option="-DHW_BUILD_FOR_DEBUGGING" />
				</Compiler>
				<Linker>
					<Add option="-no-pie" />
					<Add option="`pkg-config --libs sdl2`" />
					<Add option="-lGL" />
					<Add option="-lX11" />
					<Add option="-lm" />
					<Add option="-lavutil" />
					<Add option="-lswscale" />
					<Add option="-lavcodec" />
					<Add option="-lavformat" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/homeworld" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=gnu11" />
					<Add option="-Wno-unused-result" />
					<Add option="`pkg-config --cflags sdl2`" />
					<Add option="-Wno-implicit-function-declaration" />
					<Add option="-Wno-incompatible-pointer-types" />
					<Add option="-Wno-int-conversion" />
					<Add option="-Wno-pointer-to-int-cast" />
					<Add option="-Wno-int-to-pointer-cast" />
					<Add option="-DHW_BUILD_FOR_DISTRIBUTION" />
				</Compiler>
				<Linker>
					<Add option="-no-pie" />
					<Add option="`pkg-config --libs sdl2`" />
					<Add option="-lGL" />
					<Add option="-lX11" />
					<Add option="-lm" />
					<Add option="-lavutil" />
					<Add option="-lswscale" />
					<Add option="-lavcodec" />
					<Add option="-lavformat" />
				</Linker>
			</Target>
			<Target title="Debug_AROS">
				<Option output="bin/Debug_AROS/homeworld" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Debug_AROS/" />
				<Option type="0" />
				<Option compiler="aros_gnu_gcc_compiler" />
				<Option projectCompilerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="`sdl2-config --cflags`" />
					<Add option="-Wno-unused-result" />
					<Add option="-Wno-implicit-function-declaration" />
					<Add option="-Wno-incompatible-pointer-types" />
					<Add option="-Wno-int-conversion" />
					<Add option="-Wno-pointer-to-int-cast" />
					<Add option="-Wno-int-to-pointer-cast" />
					<Add option="-DHW_BUILD_FOR_DEBUGGING" />
					<Add option="-D__AROS__" />
				</Compiler>
				<Linker>
					<Add option="-Wl,-u,pthread_once -Wl,-u,pthread_key_create -Wl,-u,pthread_getspecific -Wl,-u,pthread_setspecific -Wl,-u,pthread_mutex_lock -Wl,-u,pthread_mutex_unlock" />
					<Add option="-lavutil" />
					<Add option="-lswscale" />
					<Add option="-lavcodec" />
					<Add option="-lavformat" />
					<Add library="SDL2" />
